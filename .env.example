# Local development uses an embedded, persistent PostgreSQL database.
LOCAL_DATABASE=embedded
LOCAL_DATABASE_PORT=5433
LOCAL_DATABASE_DIR=./storage/postgres

# To use Docker or managed PostgreSQL, remove LOCAL_DATABASE and set DATABASE_URL.
# DATABASE_URL=postgresql://postgres:change-this-password@127.0.0.1:5432/b2g_dashboard

SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=support@example.com
ADMIN_NAME=Admin Support B2G
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters-long
PORT=3000
NODE_ENV=development
STORAGE_DIR=./storage/project-documents

# Supabase credentials for the Vite client.
# Use the project URL and publishable/anon key from Supabase project settings.
# These values are exposed to the browser; never put a service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
